# production host domains
W1_PROD_IP=<PROD-IP>/api

CLIENT_PROD_IP=<PROD-IP>
CLIENT_PROD_PORT=3000
W3_CLIENT_PROD_HOST=localhost:3000

BACKEND_PROD_IP=<PROD-IP>
BACKEND_PROD_PORT=5001

# development host domains
CLIENT_DEV_IP=localhost
CLIENT_DEV_PORT=3000

# Listen on all interfaces so host/frontend containers can reach dev server
BACKEND_DEV_IP=0.0.0.0
BACKEND_DEV_PORT=5001

# Path to slink2dali binary
SLINK2DALIPATH=/app/slink2dali # CHANGE THIS
                               # the path/directory should not include '/' at the end
# Control slink2dali logging verbosity (optional)
SLINK2DALI_VERBOSE_LOGS=false  # when true, keep detailed slink2dali logs; default is false to reduce disk usage
SLINK2DALI_VERBOSITY=-v        # slink2dali verbosity flag (e.g. -v, -vv, -q); defaults to -v if unset


# Local File Stores Directory
LOCALDBS_DIRECTORY=/app/localDBs # CHANGE THIS
                                 # the path/directory should not include '/' at the end
# Root directory for Raspberry Shake settings (optional)
RSHAKE_SETTINGS_PATH=/opt/settings  # used to discover station.cfg and related metadata; defaults to /opt/settings if unset

# W1 domains
W1_DEV_IP=earthquake-hub-backend_sender-backend_dep-test
W1_DEV_PORT=5000
# Optional W1 refresh-token endpoint (defaults to /device/refresh-token if unset)
# W1_REFRESH_PATH=/device/refresh-token
# W1 TLS validation policy:
# true  = preserve legacy behavior (skip TLS certificate verification for W1 calls)
# false = enforce certificate verification (recommended when device trust store is correctly configured)
W1_ALLOW_INSECURE_TLS=true

# Sender-originated RShake alert notifications to central backend
RSHAKE_ALERTS_ENABLED=true
W1_RS_ALERT_PATH=/messaging/restricted/rshake-alert
RSHAKE_ALERT_POST_TIMEOUT_MS=5000
# Optional manual shared secret override for central endpoint auth.
# In normal operation this is auto-issued by the hub after device linking and
# persisted on the device, so operators do not need to set it manually.
# RSHAKE_ALERT_SHARED_SECRET=replace_with_long_random_secret
# Optional payload schema version override
# RSHAKE_ALERT_SCHEMA_VERSION=1.0
# Optional post retry/cooldown controls (defaults preserve current behavior)
RSHAKE_ALERT_RETRY_ATTEMPTS=0
RSHAKE_ALERT_RETRY_BASE_MS=500
RSHAKE_ALERT_MIN_INTERVAL_SEC=0
# Optional local queue for transient alert delivery failures (disabled by default)
RSHAKE_ALERT_QUEUE_ENABLED=false
# RSHAKE_ALERT_QUEUE_FILE=/app/localDBs/rshake-alert-queue.json
# RSHAKE_ALERT_QUEUE_MAX_SIZE=200
# RSHAKE_ALERT_QUEUE_MAX_ATTEMPTS=20
# RSHAKE_ALERT_QUEUE_BACKOFF_MS=30000
# RSHAKE_ALERT_COOLDOWN_STATE_FILE=/app/localDBs/rshake-alert-cooldown-state.json

# Sender auto-update bundle/image controls (GHCR)
SENDER_BUNDLE_TAG=latest
SENDER_BACKEND_IMAGE_REPO=ghcr.io/upri-earthquake/sender-backend
SENDER_FRONTEND_IMAGE_REPO=ghcr.io/upri-earthquake/sender-frontend
# When true, failed UPDATE_STACK runs attempt rollback to previous running digests.
AUTO_UPDATE_ROLLBACK_ENABLED=true
SENDER_HOST_SCRIPTS_DIR=/opt/upri/host-scripts
SENDER_SCRIPT_SYNC_MODE=fallback
SENDER_SCRIPT_SYNC_TIMEOUT_SEC=20

# Auto-update alerting transport (shared by timer + startup hook)
AUTO_UPDATE_ALERT_ENDPOINT=https://earthquake.science.upd.edu.ph/api/messaging/restricted/rshake-alert
AUTO_UPDATE_ALERT_TIMEOUT_SEC=8

# Stack watchdog (container stale/restart protection)
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_MINUTES=5
WATCHDOG_BACKEND_STOPPED_MAX_SEC=900
WATCHDOG_FRONTEND_STOPPED_MAX_SEC=900
WATCHDOG_BACKEND_UNHEALTHY_MAX_SEC=900
WATCHDOG_FRONTEND_UNHEALTHY_MAX_SEC=900
WATCHDOG_RESTART_COOLDOWN_SEC=300
# Optional explicit watchdog state/lock files
# WATCHDOG_STATE_FILE=/var/lib/upri-sender/watchdog-state.env
# WATCHDOG_LOCK_FILE=/tmp/upri-sender-maintenance.lock

# Disk-space alerts (evaluated during sender-backend UPDATE_STACK runs)
DISK_ALERT_PATHS=/,/app/localDBs
DISK_ALERT_WARN_FREE_PCT=15
DISK_ALERT_CRITICAL_FREE_PCT=8
DISK_ALERT_RECOVERY_FREE_PCT=20
# Optional explicit state-file path (default: /var/lib/upri-sender/disk-alert-state.env)
# DISK_ALERT_STATE_FILE=/var/lib/upri-sender/disk-alert-state.env

# Deprecated URL-based script self-update settings (ignored by v2 host updater)
# SENDER_SCRIPT_AUTO_UPDATE_ENABLED=true
# SENDER_BACKEND_SCRIPT_URL=https://raw.githubusercontent.com/UPRI-earthquake/sender-backend/main/sender-backend.sh
# SENDER_FRONTEND_SCRIPT_URL=https://raw.githubusercontent.com/UPRI-earthquake/sender-frontend/main/sender-frontend.sh

# Clock health NTP target (used by /health/time)
NTP_SERVER_HOST=time.google.com
NTP_SERVER_HOSTS=time.google.com,0.asia.pool.ntp.org,1.asia.pool.ntp.org
NTP_SERVER_PORT=123
NTP_REQUEST_TIMEOUT_MS=2000
# Legacy single-host override for NTP server (optional; prefer NTP_SERVER_HOSTS)
# NTP_SERVER=time.google.com

# Ringserver health defaults (used by /health/network)
RINGSERVER_DEFAULT_PORT=18000     # default TCP port for ringserver connectivity checks
RINGSERVER_TCP_TIMEOUT_MS=5000   # TCP connection timeout (ms) when probing ringserver
# Default ringserver policy (auto-add on successful /device/link)
AUTO_ADD_DEFAULT_RINGSERVER_ON_LINK=true
DEFAULT_RINGSERVER_USERNAME=UP-Diliman
# Optional explicit override (format: protocol://host:port). When set, username lookup is skipped.
# DEFAULT_RINGSERVER_URL=https://earthquake.science.upd.edu.ph:16000
# Optional: allow /health/network HTTPS probe to skip TLS certificate validation.
# Keep false unless you are intentionally probing a self-signed endpoint.
HEALTH_ALLOW_INSECURE_TLS=false

# Resource health sampling (used by /health/resources)
RESOURCE_DISK_PATH=/             # filesystem path to monitor for disk usage
RESOURCE_CPU_SAMPLE_MS=1000      # CPU load sampling window in milliseconds

# Metrics + health history export (used by /health/metrics)
METRICS_PERSIST_HEALTH_HISTORY=true
# METRICS_HEALTH_HISTORY_FILE=/app/localDBs/health-history.json
METRICS_HEALTH_HISTORY_LIMIT=120
METRICS_HEALTH_HISTORY_FLUSH_MS=250
# Optional structured JSON request logs
SENDER_STRUCTURED_LOGS=false
# Optional sender-state remote tunnel snapshot path.
# Use this only if sender-backend can access the same file path as host remote tunnel service.
# REMOTE_TUNNEL_STATE_FILE=/var/lib/upri-sender/remote-tunnel-state.json

# Host-side reverse tunnel auto-enrollment (sender-backend.sh)
REMOTE_TUNNEL_AUTO_REGISTER_ENABLED=false
# Optional override; when unset sender-backend.sh derives from W1_* env as <W1>/device/tunnel/enroll
# REMOTE_TUNNEL_ENROLL_ENDPOINT=https://earthquake.science.upd.edu.ph/api/device/tunnel/enroll
# Sensor bearer token used for enrollment API auth
# REMOTE_TUNNEL_ENROLL_TOKEN=replace_with_sensor_access_token
REMOTE_TUNNEL_ENROLL_REQUEST_TIMEOUT_SEC=15
# WebSocket tunnel endpoint (host/root only; path comes from REMOTE_TUNNEL_WSS_PATH_PREFIX)
REMOTE_TUNNEL_WSS_URL=wss://earthquake.science.upd.edu.ph
# Keep this in sync with the server's TUNNEL_WSS_PATH_PREFIX.
# Use a long random value in production (example: api/ws-tunnel/8f9a3d...).
REMOTE_TUNNEL_WSS_PATH_PREFIX=

#MongoDB 
MONGO_CONNX_TYPE=docker
MONGO_HOST=mongodb_sender-backend_dep-test
MONGO_PORT=27017
MONGO_NAME=latestEQs

# production host domain (and for deployment testing)
CLIENT_PROD_HOST=localhost       # web app domain name
BACKEND_PROD_HOST=localhost/api
BACKEND_PROD_PORT=5000

#jsonwebtoken keys
ACCESS_TOKEN_PRIVATE_KEY=replace_with_secure_random
JWT_EXPIRY='30 days'

# Token refresh settings
# How often (ms) to check token age and refresh proactively; defaults to 900000 (15m) if unset
REFRESH_CHECK_INTERVAL_MS=900000
# Refresh when within this many ms of expiry; defaults to 600000 (10m) if unset
REFRESH_EXPIRY_LEEWAY_MS=600000
# Treat refresh tokens as expiring this many seconds before their actual expiry (defaults to 86400 / 24h)
REFRESH_TOKEN_LEEWAY_SECONDS=86400
# Token refresh alert controls (auto-refresh scheduler)
TOKEN_REFRESH_ALERTS_ENABLED=true
TOKEN_REFRESH_FAILED_CONSECUTIVE_THRESHOLD=2
TOKEN_REFRESH_SUCCESS_COOLDOWN_SEC=86400
# Optional explicit state-file path (defaults to LOCALDBS_DIRECTORY/token-refresh-alert-state.json)
# TOKEN_REFRESH_ALERT_STATE_FILE=/app/localDBs/token-refresh-alert-state.json

# Push notifications keys. You can generate them with command "./node_modules/.bin/web-push generate-vapid-keys"
PUBLIC_VAPID_KEY=paste_public_key_here
PRIVATE_VAPID_KEY=paste_private_key_here
# This must be either a URL or a 'mailto:' address.
# For example: 'https://my-site.com/contact' or 'mailto: contact@my-site.com'
WEB_PUSH_CONTACT=mailto: contact@my-site.com

NODE_ENV=development
